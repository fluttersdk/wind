{
  "permissions": {
    "allow": [
      "Bash(flutter test *)",
      "Bash(./tool/coverage.sh *)",
      "Bash(flutter analyze *)",
      "Bash(dart analyze *)",
      "Bash(dart format *)",
      "Bash(python3 tool/check-docs.py *)",
      "Bash(flutter pub publish --dry-run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/dart-format-analyze.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
